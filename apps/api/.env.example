NODE_ENV=development
PORT=3010
BASE_URL=http://localhost:3010
WEB_APP_URL=http://localhost:3000
AUTH_BASE_URL=http://localhost:3010/api/auth
CORS_ORIGINS=http://localhost:3000

AUTH_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgres://user:password@localhost:5432/workora
DATABASE_URL_UNPOOLED=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

RESEND_API_KEY=
EMAIL_FROM=Workora <no-reply@example.com>

# Google Gemini powers resume parsing and profile suggestions. Server-side only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_DAILY_LIMIT_FREE=10
AI_DAILY_LIMIT_PAID=50
AI_GLOBAL_DAILY_CAP=500

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Vercel Blob is used for private identity uploads.
BLOB_READ_WRITE_TOKEN=

# Optional S3-compatible private storage. All four values are required together.
S3_ENDPOINT=
S3_REGION=eu-west-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Yoti IDV backend SDK. YOTI_API_KEY is the application PEM private key from
# Yoti Hub. Literal \n escapes are accepted for single-line env files.
# Leave both empty to use manual admin review only.
YOTI_SDK_ID=
YOTI_API_KEY=

# Identity verification is paused until the keys above and private storage are
# ready. Leave false so no signup, dashboard, posting or proposal flow is blocked.
REQUIRE_VERIFICATION=false

# MCP / OAuth 2.1. Set the issuer to the public HTTPS web origin, not the API host.
# MCP_RESOURCE_URL defaults to ${MCP_ISSUER_URL}/api/mcp.
MCP_ENABLED=true
MCP_ISSUER_URL=https://workora.com
MCP_RESOURCE_URL=https://workora.com/api/mcp
MCP_ACCESS_TOKEN_TTL_SECONDS=3600
MCP_REFRESH_TOKEN_TTL_SECONDS=2592000

# Remote MCP server + OAuth 2.1 for ChatGPT, Claude and other MCP clients.
# Leave MCP_ISSUER_URL / MCP_RESOURCE_URL empty to derive them from WEB_APP_URL.
MCP_ENABLED=true
MCP_ISSUER_URL=https://workora.com
MCP_RESOURCE_URL=https://workora.com/api/mcp
MCP_ACCESS_TOKEN_TTL_SECONDS=3600
MCP_REFRESH_TOKEN_TTL_SECONDS=2592000
