# Runtime
NODE_ENV=development
PORT=3010
BASE_URL=http://localhost:3010
# Where the customer-facing app lives (used for auth email links)
WEB_APP_URL=http://localhost:3000

# Database
# Production / any real PostgreSQL:
# DATABASE_URL=postgres://workora:password@localhost:5432/workora_api
# Local development without a local server running: embedded PGlite.
#   DATABASE_URL=pglite://            (ephemeral, in-memory
#   DATABASE_PGLITE_PATH=.pglite      (file-backed, picked up as dev database)
DATABASE_URL=postgresql://postgres@localhost:5432/workora
DATABASE_PGLITE_PATH=.pglite

# Auth (Better Auth)
AUTH_BASE_URL=http://localhost:3010
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-generate-a-real-secret-for-production
# Comma separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000

# Email (Resend). Leave empty in development to print links to the server log instead.
RESEND_API_KEY=
EMAIL_FROM=Workora <no-reply@example.com>

# Payments: set both secrets to enable the provider. In development either may stay empty.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# S3-compatible object storage for files (documents, receipts).
# Not required for the API to boot; upload endpoints return 503 until configured.
S3_ENDPOINT=
S3_REGION=eu-west-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
