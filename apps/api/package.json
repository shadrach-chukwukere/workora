{
    "name": "workora-api",
    "version": "1.0.0",
    "description": "Production API for the Workora freelance marketplace",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "node --watch --experimental-vm-modules --import tsx src/server.ts",
        "build": "tsc -p tsconfig.build.json",
        "start": "node dist/server.js",
        "typecheck": "tsc --noEmit",
        "migrate": "node --import tsx src/database/migrate.ts",
        "seed": "node --import tsx src/database/seeds/seed.ts",
        "db:setup": "node --import tsx -e \"import('./src/database/migrate.js').then(m => m.migrate()).then(() => import('./src/database/seeds/seed.js')).then(s => s.seed()).then(() => console.log('database up to date'))\"",
        "test": "node --import tsx --test test/*.test.ts",
        "test:watch": "node --import tsx --test --watch test/*.test.ts",
        "admin:create": "node --import tsx src/modules/admin/create-admin.ts"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.726.0",
        "@aws-sdk/s3-request-presigner": "^3.726.0",
        "@better-auth/kysely-adapter": "^1.7.18",
        "@electric-sql/pglite": "^0.5.15",
        "@fastify/cookie": "^11.0.2",
        "@fastify/cors": "^11.0.0",
        "@fastify/helmet": "^13.0.1",
        "@fastify/multipart": "^9.0.1",
        "@fastify/rate-limit": "^10.2.2",
        "@fastify/swagger": "^9.9.3",
        "@fastify/swagger-ui": "^6.1.3",
        "@fastify/type-provider-zod": "^1.0.3",
        "@node-rs/argon2": "^2.2.2",
        "better-auth": "^1.7.18",
        "dotenv": "^18.0.9",
        "fastify": "^5.12.8",
        "fastify-plugin": "^5.0.1",
        "kysely": "^0.29.8",
        "kysely-codegen": "^0.20.0",
        "pg": "^8.13.1",
        "pino": "^9.6.0",
        "pino-pretty": "^13.0.0",
        "resend": "^6.37.0",
        "stripe": "^23.1.0",
        "tsx": "^4.23.15",
        "ws": "^8.18.0",
        "zod": "^4.2.1"
    },
    "devDependencies": {
        "@types/node": "^24.10.0",
        "@types/pg": "^8.23.1",
        "@types/ws": "^8.5.13",
        "typescript": "^5.8.2"
    }
}
