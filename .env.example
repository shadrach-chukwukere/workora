# Next.js web app. Leave API_URL empty on Vercel so browser calls stay same-origin
# and Next.js rewrites /api/* to the API origin configured below.
API_URL=http://localhost:3010
NEXT_PUBLIC_SITE_URL=https://workora-phi.vercel.app

# Browser-side public origin (normally empty in production; see README).
NEXT_PUBLIC_API_URL=

# Public web origin used as the OAuth issuer and by sitemap/robots/OpenAPI.
# Set this to the deployed HTTPS origin; no secrets belong in this file.
WEB_APP_URL=https://workora-phi.vercel.app
