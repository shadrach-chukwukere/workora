# Frontend (Next.js) environment

# Server-only absolute backend URL used by Server Components and API helpers
# (@/lib/api-server.ts, @/lib/api-data.ts, session-guard). Never exposed to
# the browser. Safe local default; override in production (Vercel project env
# / Render env) when the backend address changes.
API_URL=http://localhost:3010

# Browser-facing API base. Leave empty so client fetch calls use relative URLs
# (/api/auth/*, /api/v1/*) that Next.js rewrites proxy to the backend, keeping
# the session cookie on the frontend domain. Do not set this to the Render
# backend: cookies would then be stored for render.com and the dashboard guard
# on the frontend domain would see no session.
NEXT_PUBLIC_API_URL=
